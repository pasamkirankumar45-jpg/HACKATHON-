# ==========================================
# CodeSync Environment Variables Configuration
# ==========================================

# Application Port
PORT=3000

# Django Backend Configuration
SECRET_KEY="codesync-production-secret-key-change-me"
DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/codesync"
POSTGRES_DB="codesync"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Redis & Celery Message Broker
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
JWT_SECRET="codesync-jwt-token-signing-key-32chars"

# End-to-End Encryption Salt/Key
ENCRYPTION_KEY="codesync-default-e2ee-key-salt"

# Google Gemini API Key (Server-side AI Assistant)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
